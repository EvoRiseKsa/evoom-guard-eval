{
  "mem_limit": 0,
  "policy_id": "oss-compat/ripgrep-rust185",
  "policy_version": "1",
  "require_candidate_isolation": "subprocess",
  "require_report_integrity": "same_process_candidate_writable",
  "setup_command": ["/usr/local/sbin/evoom-oss-untrusted-exec", "--phase", "setup", "--", "cargo", "fetch", "--locked"],
  "setup_output_globs": ["target/**"],
  "test_command": ["/usr/local/sbin/evoom-oss-untrusted-exec", "--phase", "test", "--", "cargo", "test", "--locked", "--offline", "--workspace"],
  "timeout": 1200
}
