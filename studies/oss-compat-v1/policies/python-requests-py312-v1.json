{
  "mem_limit": 0,
  "policy_id": "oss-compat/requests-py312",
  "policy_version": "1",
  "require_candidate_isolation": "subprocess",
  "require_report_integrity": "same_process_candidate_writable",
  "setup_command": ["/usr/local/sbin/evoom-oss-untrusted-exec", "--phase", "setup", "--", "python", "-m", "pip", "install", "--user", "--disable-pip-version-check", "--no-input", "-r", "requirements-dev.txt"],
  "setup_output_globs": ["src/*.egg-info/**"],
  "test_command": ["/usr/local/sbin/evoom-oss-untrusted-exec", "--phase", "test", "--", "python", "-m", "pytest", "tests", "-q", "-o", "addopts=", "-p", "no:cacheprovider"],
  "timeout": 900
}
